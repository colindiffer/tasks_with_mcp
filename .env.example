# Slack
SLACK_ACCESS_TOKEN=xoxp-...
SLACK_FULL_DM_SWEEP=false
SLACK_DM_DISCOVERY_LIMIT=10
SLACK_DM_RECENT_WINDOW_HOURS=48
SLACK_DM_EXCLUDELIST=
SLACK_MONITOR_THREAD_CHANNELS=gtm_monitor_checks

# Microsoft Graph (Outlook + Teams chats)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
OUTLOOK_USER_EMAIL=colin@...
OUTLOOK_REFRESH_TOKEN=

# Optional persistence overrides
# For Railway, set STATE_DIR to your attached volume mount path, for example /data.
STATE_DIR=
STATE_FILE=
OUTLOOK_TOKEN_FILE=

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
MAX_CATCHUP_DAYS=30

# Trello
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_INTAKE_LIST_ID=

# Cron schedule (default: every 15 minutes)
CRON_SCHEDULE=*/15 * * * *
SLACK_MONITOR_CRON_SCHEDULE=*/5 * * * *
SLACK_FULL_SWEEP_CRON_SCHEDULE=0 0 * * *
STARTUP_FULL_SWEEP=false

# Optional bounded replay window
BACKFILL_SINCE=
BACKFILL_UNTIL=
