{
  "name": "cpa",
  "version": "1.0.0",
  "description": "CPA (Colin's Personal Assistant): automated task capture from Slack, Outlook, and Teams to Trello",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:bg": "powershell -ExecutionPolicy Bypass -File scripts/start-cpa-background.ps1"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@slack/web-api": "^7.0.0",
    "dotenv": "^16.4.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
